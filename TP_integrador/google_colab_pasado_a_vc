from datetime import date
from sqlalchemy import Column, Integer, String, Boolean, Date, ForeignKey, Float, create_engine
from sqlalchemy.orm import DeclarativeBase, relationship, Session


class Base(DeclarativeBase):
    pass

class Jugador(Base):
    __tablename__ = "Jugador"

    id = Column(Integer, primary_key=True)
    nombre = Column(String, nullable=False)
    usuario = Column(String, nullable=False)
    pais = Column(String)
    activo = Column(Boolean, default=True)

    def __repr__(self):
        return f"<Jugador(id={self.id}, nombre='{self.nombre}', usuario='{self.usuario}')>"

class Equipo(Base):
    __tablename__ = "Equipo"

    id = Column(Integer, primary_key=True)
    nombre = Column(String, nullable=False)
    pais = Column(String)
    fundacion = Column(Date)

    # Relaciones con Partida
    partidas_local = relationship("Partida", foreign_keys="Partida.equipo_local_id", back_populates="equipo_local")
    partidas_visitante = relationship("Partida", foreign_keys="Partida.equipo_visitante_id", back_populates="equipo_visitante")

    def __repr__(self):
        return f"<Equipo(id={self.id}, nombre='{self.nombre}')>"

class Torneo(Base):
    __tablename__ = "Torneo"

    id = Column(Integer, primary_key=True)
    nombre = Column(String, nullable=False)
    juego = Column(String, nullable=False)
    fecha_inicio = Column(Date)
    premio = Column(Float)

    # Relación con Partida
    partidas = relationship("Partida", back_populates="torneo")

    def __repr__(self):
        return f"<Torneo(id={self.id}, nombre='{self.nombre}', juego='{self.juego}')>"

class Partida(Base):
    __tablename__ = "Partida"

    id = Column(Integer, primary_key=True)
    fecha = Column(Date)
    resultado = Column(String)  # ej: '3-1', 'EMPATE'
    torneo_id = Column(Integer, ForeignKey('Torneo.id'))
    equipo_local_id = Column(Integer, ForeignKey('Equipo.id'))
    equipo_visitante_id = Column(Integer, ForeignKey('Equipo.id'))

    # Relaciones pertenecientes a Partida
    torneo = relationship("Torneo", back_populates="partidas")
    equipo_local = relationship("Equipo", foreign_keys=[equipo_local_id], back_populates="partidas_local")
    equipo_visitante = relationship("Equipo", foreign_keys=[equipo_visitante_id], back_populates="partidas_visitante")

    def __repr__(self):
        return f"<Partida(id={self.id}, fecha={self.fecha}, resultado='{self.resultado}')>"


